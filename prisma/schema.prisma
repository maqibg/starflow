generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique  // 恢复 unique 约束
  emailVerified DateTime?
  image         String?

  // GitHub 特定字段
  githubId      Int?      @unique  // 通过 githubId 区分不同的 GitHub 账号
  username      String?
  avatarUrl     String?
  accessToken   String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastSyncAt    DateTime?

  lists         List[]
  notes         Note[]
  repositories  UserRepository[]
  aiConfig      AIConfig?
  syncSchedule  SyncSchedule?
  snapshots     OrganizeSnapshot[]

  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Repository {
  id              String   @id @default(cuid())
  githubId        Int      @unique
  fullName        String   @unique
  name            String
  owner           String
  description     String?
  language        String?
  stargazersCount Int      @default(0)
  forksCount      Int      @default(0)
  isArchived      Boolean  @default(false)
  htmlUrl         String
  homepage        String?
  topics          String   @default("[]")
  pushedAt        DateTime?
  repoCreatedAt   DateTime?
  repoUpdatedAt   DateTime?
  readmeSummary   String?  // AI 分类用的 README 摘要

  users UserRepository[]
  notes Note[]
}

model UserRepository {
  id           String   @id @default(cuid())
  userId       String
  repositoryId String
  starredAt    DateTime @default(now())
  isStarred    Boolean  @default(true)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  lists      ListRepository[]

  @@unique([userId, repositoryId])
  @@index([userId])
  @@index([repositoryId])
}

model List {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  color       String   @default("#6366f1")
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories ListRepository[]

  @@unique([userId, name])
  @@index([userId])
}

model ListRepository {
  id               String   @id @default(cuid())
  listId           String
  userRepositoryId String
  addedAt          DateTime @default(now())

  list           List           @relation(fields: [listId], references: [id], onDelete: Cascade)
  userRepository UserRepository @relation(fields: [userRepositoryId], references: [id], onDelete: Cascade)

  @@unique([listId, userRepositoryId])
  @@index([listId])
  @@index([userRepositoryId])
}

model Note {
  id           String   @id @default(cuid())
  userId       String
  repositoryId String
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryId])
  @@index([userId])
  @@index([repositoryId])
}

model AIConfig {
  id              String   @id @default(cuid())
  userId          String   @unique
  provider        String   @default("openai") // openai, ollama
  apiKey          String?
  baseUrl         String?  // 自定义端点（代理/Ollama）
  model           String   @default("gpt-3.5-turbo")
  enabled         Boolean  @default(false)
  requestInterval Int      @default(1000) // 请求间隔（毫秒）
  concurrency     Int      @default(3)    // 并发数
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 定时同步配置：每个用户一条，cron 为 cron 表达式字符串
model SyncSchedule {
  id         String    @id @default(cuid())
  userId     String    @unique
  enabled    Boolean   @default(false)
  cron       String    @default("0 3 * * *")
  lastRunAt  DateTime?
  lastStatus String?   // success | error
  lastError  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 整理快照：清除 Lists 或笔记前自动保存，用于整体恢复
model OrganizeSnapshot {
  id        String   @id @default(cuid())
  userId    String
  label     String   // 触发原因，例如「清除所有 Lists」
  payload   String   // JSON：列表及其包含的仓库、笔记内容
  listCount Int      @default(0)
  noteCount Int      @default(0)
  repoCount Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

